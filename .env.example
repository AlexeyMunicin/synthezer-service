# App
APP_NAME=VOXSYNC
DEBUG=false
# Generate a unique value with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Then set SECRET_KEY in your local .env file. Do not commit .env.

# Storage
STORAGE_PATH=./storage

# Whisper: tiny | base | small | medium | large-v3
WHISPER_MODEL=small

# Optional settings retained for future queue/model configuration
TTS_MODEL=piper
REDIS_URL=redis://localhost:6379/0
